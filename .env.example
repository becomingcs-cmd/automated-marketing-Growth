# PostgreSQL. Never commit a real connection string.
DATABASE_URL=postgresql://growthos:growthos@127.0.0.1:5432/growthos

# Local-only preview access. The app refuses this setting in production.
DEMO_MODE=true

# External side effects remain off until a publishing integration is approved.
SAFE_MODE=true

# Clerk pilot authentication. Obtain these from the Clerk/Vercel integration.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding
